{
  "name": "@aiyoume/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && wrangler dev",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:preview": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env preview",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "db:migrate": "wrangler d1 migrations apply LEADS_DB --remote",
    "db:migrate:preview": "wrangler d1 migrations apply LEADS_DB --remote --env preview",
    "test:lighthouse": "lhci autorun --config=lighthouserc.json",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@aiyoume/content": "*",
    "@aiyoume/ui": "*",
    "@opennextjs/cloudflare": "^1.17.1",
    "@sanity/vision": "^4.13.0",
    "next": "^16.1.6",
    "next-sanity": "^12.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sanity": "^5.14.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@cloudflare/workers-types": "^4.20260310.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.37.0",
    "eslint-config-next": "^16.1.6",
    "wrangler": "^4.67.0"
  }
}
