{
  "ci": {
    "collect": {
      "startServerCommand": "npm run build && npx next start --hostname 127.0.0.1 --port 3200",
      "startServerReadyPattern": "Ready in|Ready on|Local:",
      "startServerReadyTimeout": 240000,
      "url": [
        "http://127.0.0.1:3200/",
        "http://127.0.0.1:3200/learning",
        "http://127.0.0.1:3200/contact?service=automation",
        "http://127.0.0.1:3200/security"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage",
        "emulatedFormFactor": "mobile"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
