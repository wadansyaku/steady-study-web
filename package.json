{
  "name": "aiyoume-platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @aiyoume/web",
    "build": "npm run build --workspace @aiyoume/web",
    "preview": "npm run preview --workspace @aiyoume/web",
    "deploy": "npm run deploy --workspace @aiyoume/web",
    "deploy:preview": "npm run deploy:preview --workspace @aiyoume/web",
    "lint": "npm run lint --workspace @aiyoume/web",
    "typecheck": "npm run typecheck --workspace @aiyoume/ui && npm run typecheck --workspace @aiyoume/content && npm run typecheck --workspace @aiyoume/web",
    "db:migrate": "npm run db:migrate --workspace @aiyoume/web",
    "db:migrate:preview": "npm run db:migrate:preview --workspace @aiyoume/web",
    "test:lighthouse": "npm run test:lighthouse --workspace @aiyoume/web",
    "test:e2e": "npm run test:e2e --workspace @aiyoume/web",
    "test:e2e:update": "npm run test:e2e:update --workspace @aiyoume/web",
    "voidrush:sync": "npm run sync:root-assets --workspace @aiyoume/voidrush"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
