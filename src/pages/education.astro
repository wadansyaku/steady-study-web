---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { routeSeo } from '@/config';

const seo = routeSeo('learning');
---

<BaseLayout
  title={seo.title}
  description="このページは AIYouMe Learning に移動しました。"
  canonicalPath={seo.path}
  noindex
>
  <section class="section">
    <div class="container compact text-center">
      <h1 class="h1">ページを移動しました</h1>
      <p class="lead text-muted">
        旧URL `/education` は、`/learning` に統合されました。
      </p>
      <a class="btn btn-primary" href={seo.path}>AIYouMe Learningへ移動する</a>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    if (window.location.pathname === '/education' || window.location.pathname === '/education/') {
      window.location.replace('/learning');
    }
  })();
</script>

<style>
  .compact {
    max-width: 720px;
  }
</style>
