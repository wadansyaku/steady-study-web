---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CTAButton from '@/components/CTAButton.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import InfoCard from '@/components/InfoCard.astro';
import { config, routeSeo } from '@/config';

const seo = routeSeo('studio');

const services = [
  {
    title: '音楽制作',
    icon: '🎵',
    points: ['BGM / ジングル / 効果音', '歌ってみたMIX / マスタリング', '用途に合わせた尺・雰囲気の提案'],
  },
  {
    title: '動画編集',
    icon: '🎬',
    points: ['YouTube動画 / ショート動画', 'カット / テロップ / 整音', '運用しやすいテンプレート整備'],
  },
  {
    title: 'クリエイティブ制作',
    icon: '🧩',
    points: ['要件整理と構成提案', '制作後の改善サイクル設計', 'B2C / B2B双方で使える表現設計'],
  },
] as const;

const process = [
  { title: '課題整理', desc: '背景・目的・納期・予算を整理し、優先順位を明確化します。' },
  { title: '設計と提案', desc: '方向性と成果物の定義をすり合わせ、制作計画を提示します。' },
  { title: '制作と確認', desc: '段階レビューを挟みながら、用途に合う形へ精度を高めます。' },
  { title: '納品と改善', desc: '運用開始後の改善ポイントも整理し、次の施策に繋げます。' },
] as const;
---

<BaseLayout title={seo.title} description={seo.description}>
  <section class="section hero-section">
    <div class="container narrow text-center">
      <span class="pill-badge">{config.brands.studio}</span>
      <h1 class="h1">制作を、思いつきではなく運用できる形に。</h1>
      <p class="lead">
        音楽制作・動画編集・クリエイティブ制作を、受託だけでなく伴走にも対応。 
        目的に沿って、再現できる制作フローを整えます。
      </p>
      <div class="actions justify-center">
        <CTAButton kind="line" label="LINEで制作相談" />
        <a class="btn btn-outline" href="/contact">メールで問い合わせ</a>
      </div>
    </div>
  </section>

  <section class="section-sm bg-surface">
    <div class="container">
      <SectionHeading title="対応領域" subtitle="Services" center />
      <div class="grid cols-3 service-grid">
        {
          services.map((service) => (
            <InfoCard title={service.title} icon={service.icon}>
              <ul class="clean-list">
                {service.points.map((point) => <li>{point}</li>)}
              </ul>
            </InfoCard>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container">
      <SectionHeading title="進め方" subtitle="Process" center />
      <div class="grid cols-4 process-grid">
        {
          process.map((item, index) => (
            <article class="card process-card">
              <p class="step">0{index + 1}</p>
              <h3 class="h3">{item.title}</h3>
              <p class="text-muted">{item.desc}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container narrow">
      <div class="card note-card">
        <SectionHeading title="関連コンテンツ" subtitle="Studio Note" />
        <p class="text-muted">
          制作現場で使っている機材や運用の知見を記事として公開しています。案件の準備段階でも参考にできます。
        </p>
        <p class="experiment-note">
          VOID-RUSH は Studio 配下で公開している実験コンテンツです。主要サービス導線ではなく、開発・運用の検証事例として扱います。
        </p>
        <div class="actions">
          <a class="btn btn-outline" href="/articles/studio-canare-gs6">機材記事を読む</a>
          <a class="btn btn-ghost" href={config.apps.voidrush.path}>VOID-RUSH 実験コンテンツを見る</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container narrow">
      <div class="card cta-box text-center">
        <h2 class="h2">制作相談はこちら</h2>
        <p class="text-muted">
          「何を頼めばいいか分からない」状態でも大丈夫です。要件整理から一緒に進めます。
        </p>
        <div class="actions justify-center">
          <CTAButton kind="line" label="LINEで相談する" />
          <a class="btn btn-primary" href="/contact">お問い合わせページへ</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow {
    max-width: 920px;
  }

  .hero-section {
    padding-top: var(--sp-12);
  }

  .pill-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    background: rgba(99, 102, 241, 0.1);
    color: var(--brand);
    font-size: var(--text-sm);
    font-weight: 700;
    border: 1px solid rgba(99, 102, 241, 0.2);
    margin-bottom: var(--sp-4);
  }

  .bg-surface {
    background: rgba(30, 41, 59, 0.32);
  }

  .service-grid {
    align-items: stretch;
  }

  .clean-list {
    margin: 0;
    padding-left: var(--sp-5);
    display: grid;
    gap: var(--sp-2);
  }

  .process-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .process-card {
    display: grid;
    gap: var(--sp-2);
    height: 100%;
  }

  .step {
    margin: 0;
    color: var(--text-dim);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    font-weight: 800;
  }

  .note-card {
    display: grid;
    gap: var(--sp-4);
  }

  .experiment-note {
    margin: 0;
    color: var(--text-dim);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .actions {
    display: flex;
    gap: var(--sp-3);
    flex-wrap: wrap;
  }

  .cta-box {
    padding: var(--sp-8);
    display: grid;
    gap: var(--sp-4);
  }

  @media (max-width: 960px) {
    .process-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 768px) {
    .process-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
