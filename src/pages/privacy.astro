---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { config } from '@/config';

const title = `プライバシーポリシー｜${config.site.name}`;
const description =
  `${config.site.name}のプライバシーポリシー。LINE・外部予約・アクセス解析・アフィリエイト・VOID-RUSH のデータ保存を含む利用方針を掲載しています。`;
---

<BaseLayout title={title} description={description}>
  <section class="section">
    <div class="container container-sm">
      <h1 class="h1 text-center mb-8">プライバシーポリシー</h1>
      <p class="text-muted text-center mb-12">
        {config.site.name}（以下「当サービス」）は、個人情報と利用データの保護を重要な責務と考え、以下の方針に基づき適切に取り扱います。
      </p>

      <div class="policy-content">
        <section class="mb-8">
          <SectionHeading title="1. 取得する情報" class="policy-heading" />
          <p class="text-muted">
            当サービスは、お問い合わせ・面談予約・資料共有・実験コンテンツの利用時に、氏名（ハンドルネームを含む）、連絡先（LINE/メール）、学年、学習状況、アクセスログ、利用端末情報などを取得する場合があります。
          </p>
        </section>

        <section class="mb-8">
          <SectionHeading title="2. 利用目的" class="policy-heading" />
          <ul class="clean-list">
            <li>・お問い合わせへの対応、面談や制作相談の日程調整</li>
            <li>・学習支援、制作支援、業務支援の提案と資料共有</li>
            <li>・実験コンテンツおよびAPIの安定運用、障害調査、不正対策</li>
            <li>・匿名化または個人が特定されない形での品質改善と利用分析</li>
          </ul>
        </section>

        <section class="mb-8">
          <SectionHeading title="3. 第三者提供" class="policy-heading" />
          <p class="text-muted">
            法令に基づく場合を除き、本人の同意なく個人情報を第三者に提供しません。外部サービスを利用する場合は、当該サービスの提供に必要な範囲で情報が送信されることがあります。
          </p>
        </section>

        <section class="mb-8">
          <SectionHeading title="4. 外部サービスの利用" class="policy-heading" />
          <p class="text-muted mb-4">
            当サービスは、利便性のため以下の外部サービスを利用します。
          </p>
          <ul class="clean-list">
            <li>
              ・LINE（連絡・相談導線）：
              <a href={config.urls.lineAddFriend} target="_blank" rel="noopener noreferrer" class="link"
                >友だち追加</a
              >
            </li>
            <li>
              ・外部予約サービス（面談予約導線）：
              <a href={config.urls.booking} target="_blank" rel="noopener noreferrer" class="link">予約ページ</a>
            </li>
            <li>・Cloudflare Pages / Functions / D1（サイト配信、API運用、ログ管理）</li>
          </ul>
          <p class="text-muted text-sm mt-2">
            ※外部サービスにおける個人情報の取り扱いについては、各サービス提供者のプライバシーポリシーをご確認ください。
          </p>
        </section>

        <section class="mb-8">
          <SectionHeading title="5. アクセス解析と広告開示" class="policy-heading" />
          <p class="text-muted mb-4">
            当サービスは、サイト改善のためアクセス解析ツールを導入する場合があります。解析タグは設定により有効化され、ページ閲覧や利用環境に関する情報が取得されることがあります。
          </p>
          <p class="text-muted">
            また、記事内では Amazon アソシエイトを含むアフィリエイトリンクを利用する場合があります。対象ページには広告開示を表示し、購入や在庫確認は外部サイト上で行われます。
          </p>
        </section>

        <section class="mb-8">
          <SectionHeading title="6. VOID-RUSH における保存データ" class="policy-heading" />
          <p class="text-muted mb-4">
            <code>{config.apps.voidrush.path}</code>
            は Studio 配下の実験コンテンツです。利用時には、ゲーム進行の継続と不正対策のために以下のデータを利用します。
          </p>
          <ul class="clean-list">
            <li>・ブラウザの localStorage に保存されるプレイヤー識別子、セッション識別子、進行スナップショット</li>
            <li>・API 認証のための短期トークンと関連メタデータ</li>
            <li>・マッチ結果、ミッション進行、ログインボーナス、ランキング関連データ</li>
          </ul>
          <p class="text-muted text-sm mt-2">
            これらのデータは実験コンテンツの継続利用、同期、不正検知、運用改善のために使用し、一般的な問い合わせ用途には利用しません。
          </p>
        </section>

        <section class="mb-8">
          <SectionHeading title="7. お問い合わせ" class="policy-heading" />
          <p class="text-muted">
            個人情報の取り扱いに関するお問い合わせは、<a href="/contact" class="link">お問い合わせページ</a>
            よりご連絡ください。
          </p>
        </section>

        <div class="divider border-t border-border my-8"></div>
        <p class="text-right text-muted text-sm">改定日：2026-03-09</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .container-sm {
    max-width: 800px;
    margin: 0 auto;
  }
  .mb-4 { margin-bottom: 1rem; }
  .mb-8 { margin-bottom: 2rem; }
  .mb-12 { margin-bottom: 3rem; }
  .mt-2 { margin-top: 0.5rem; }
  .my-8 { margin-top: 2rem; margin-bottom: 2rem; }

  .policy-content {
    background: rgba(30, 41, 59, 0.3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 2rem;
  }

  .clean-list {
    list-style: none;
    padding: 0;
    color: var(--text-muted);
  }
  .clean-list li {
    margin-bottom: 0.5rem;
  }

  .link {
    color: var(--brand);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .link:hover {
    color: var(--accent);
  }

  code {
    padding: 0.125rem 0.35rem;
    border-radius: var(--radius-xs);
    background: rgba(15, 23, 42, 0.5);
    border: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  .text-sm { font-size: 0.875rem; }
  .text-right { text-align: right; }

  :global(.policy-heading h2) {
    font-size: 1.25rem;
    margin-bottom: 1rem;
    border-left: 4px solid var(--brand);
    padding-left: 1rem;
  }
</style>
