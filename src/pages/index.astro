---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { config, routeSeo } from '@/config';

const seo = routeSeo('home');

const divisions = [
  {
    name: config.brands.learning,
    href: '/learning',
    summary: '受験・学習伴走。親子の不安を整理し、計画から実行・改善まで伴走します。',
    cta: 'Learningを見る',
  },
  {
    name: config.brands.studio,
    href: '/studio',
    summary: '音楽制作・動画編集・クリエイティブ制作。目的に沿った成果物を設計して実装します。',
    cta: 'Studioを見る',
  },
  {
    name: config.brands.automation,
    href: '/automation',
    summary: '法人向けAI自動化・業務設計・実装支援。小さく始めて、現場で回る運用に落とし込みます。',
    cta: 'Automationを見る',
  },
] as const;

const methodSteps = [
  {
    title: 'Diagnose',
    description: '現状を可視化し、詰まりの原因と優先順位を整理します。',
  },
  {
    title: 'Design',
    description: '目標と制約に合わせて、運用できる設計に分解します。',
  },
  {
    title: 'Run',
    description: '小さく実行し、現場の負荷が増えすぎない形で定着させます。',
  },
  {
    title: 'Review',
    description: '結果を確認し、次に効く改善を継続的に回します。',
  },
] as const;
---

<BaseLayout title={seo.title} description={seo.description}>
  <section class="section hero-section">
    <div class="container hero-inner">
      <p class="hero-eyebrow">AI + You + Me</p>
      <h1 class="h1 hero-title">AIYouMe（アイユメ）</h1>
      <p class="lead hero-lead">
        学習・制作・業務を、伴走と設計で回る状態へ。
      </p>
      <p class="hero-sub text-muted">
        AIを魔法のように扱うのではなく、摩擦を下げる道具として使いながら、
        人が判断し、人が前進できる仕組みを作ります。
      </p>
      <div class="hero-actions">
        <a class="btn btn-accent" href={config.urls.lineAddFriend} target="_blank" rel="noopener noreferrer">
          無料相談する
        </a>
        <a class="btn btn-outline" href="/contact">お問い合わせ</a>
      </div>
    </div>
  </section>

  <section class="section-sm value-section">
    <div class="container narrow">
      <SectionHeading title="Value" subtitle="何を増やし、何を減らすか" center />
      <div class="grid cols-2">
        <article class="card value-card">
          <h3 class="h3">増やすもの</h3>
          <ul>
            <li>再現できる実行手順</li>
            <li>意思決定の明確さ</li>
            <li>継続できる運用習慣</li>
          </ul>
        </article>
        <article class="card value-card">
          <h3 class="h3">減らすもの</h3>
          <ul>
            <li>手戻りと迷い</li>
            <li>属人化した進め方</li>
            <li>やりっぱなしの施策</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container narrow">
      <SectionHeading title="Vision" subtitle="目指す状態" center />
      <div class="card vision-card">
        <p>
          学習、制作、業務のどの領域でも、
          <strong>「やるべきことが明確で、実行できて、改善が続く」</strong>
          状態をつくる。
          AIYouMeは、領域ごとに切り離された支援ではなく、共通のメソッドで成果に繋がる仕組みを提供します。
        </p>
      </div>
    </div>
  </section>

  <section class="section-sm method-section">
    <div class="container">
      <SectionHeading title="Method" subtitle="Diagnose → Design → Run → Review" center />
      <p class="text-center text-muted method-note">
        AIは“魔法”ではなく、実行の摩擦を下げるための道具として使います。
      </p>
      <div class="grid cols-4 method-grid">
        {
          methodSteps.map((step, index) => (
            <article class="card method-card">
              <p class="method-index">0{index + 1}</p>
              <h3 class="h3">{step.title}</h3>
              <p class="text-muted">{step.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section divisions-section">
    <div class="container">
      <SectionHeading title="Divisions" subtitle="3つの部門" center />
      <div class="grid cols-3 division-grid">
        {
          divisions.map((division) => (
            <article class="card division-card">
              <h2 class="h3">{division.name}</h2>
              <p class="text-muted">{division.summary}</p>
              <a class="btn btn-outline w-full" href={division.href}>
                {division.cta}
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-sm final-cta-section">
    <div class="container narrow">
      <div class="card final-cta-box">
        <h2 class="h2 text-center">まずは現状整理から始めませんか</h2>
        <p class="text-center text-muted">
          相談内容が未整理でも問題ありません。状況を伺い、最初の一歩を一緒に設計します。
        </p>
        <div class="final-actions">
          <a class="btn btn-accent" href={config.urls.lineAddFriend} target="_blank" rel="noopener noreferrer">
            LINEで相談する
          </a>
          <a class="btn btn-primary" href={config.urls.booking} target="_blank" rel="noopener noreferrer">
            面談を予約する
          </a>
          <a class="btn btn-ghost" href="/contact">お問い合わせへ</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-section {
    padding-top: var(--sp-16);
    padding-bottom: var(--sp-12);
  }

  .hero-inner {
    max-width: 820px;
    text-align: center;
  }

  .hero-eyebrow {
    display: inline-block;
    margin: 0 0 var(--sp-3);
    color: var(--brand);
    font-weight: 700;
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-title {
    margin-bottom: var(--sp-4);
  }

  .hero-lead {
    margin: 0 auto var(--sp-4);
    max-width: 680px;
    font-weight: 600;
  }

  .hero-sub {
    margin: 0 auto;
    max-width: 720px;
    font-size: var(--text-base);
  }

  .hero-actions {
    margin-top: var(--sp-8);
    display: flex;
    gap: var(--sp-3);
    justify-content: center;
    flex-wrap: wrap;
  }

  .narrow {
    max-width: 860px;
  }

  .value-section .section-heading,
  .method-section .section-heading,
  .divisions-section .section-heading {
    margin-bottom: var(--sp-8);
  }

  .value-card ul {
    margin: var(--sp-4) 0 0;
    padding-left: var(--sp-5);
    color: var(--text-muted);
    display: grid;
    gap: var(--sp-2);
  }

  .vision-card {
    max-width: 760px;
    margin: 0 auto;
  }

  .vision-card p {
    margin: 0;
    line-height: var(--leading-relaxed);
  }

  .method-note {
    margin-top: calc(-1 * var(--sp-4));
    margin-bottom: var(--sp-8);
    font-size: var(--text-sm);
  }

  .method-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .method-card {
    height: 100%;
    display: grid;
    gap: var(--sp-2);
  }

  .method-index {
    margin: 0;
    color: var(--text-dim);
    font-weight: 800;
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
  }

  .division-grid {
    align-items: stretch;
  }

  .division-card {
    display: grid;
    gap: var(--sp-4);
    height: 100%;
  }

  .division-card p {
    margin: 0;
    line-height: 1.7;
  }

  .final-cta-box {
    padding: var(--sp-10);
    display: grid;
    gap: var(--sp-5);
  }

  .final-actions {
    display: flex;
    gap: var(--sp-3);
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 960px) {
    .method-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 768px) {
    .hero-section {
      padding-top: var(--sp-12);
    }

    .method-grid {
      grid-template-columns: 1fr;
    }

    .final-cta-box {
      padding: var(--sp-6);
    }
  }
</style>
