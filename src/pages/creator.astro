---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { config, routeSeo } from '@/config';

const seo = routeSeo('studio');
---

<BaseLayout
  title={seo.title}
  description="このページは AIYouMe Studio に移動しました。"
  canonicalPath={seo.path}
  noindex
>
  <section class="section">
    <div class="container compact text-center">
      <h1 class="h1">ページを移動しました</h1>
      <p class="lead text-muted">
        旧URL `/creator` は、`/studio` に統合されました。
      </p>
      <a class="btn btn-primary" href={seo.path}>AIYouMe Studioへ移動する</a>
      <p class="text-dim helper">
        VOID-RUSH は Studio 配下の実験コンテンツとして、引き続き <a href={config.apps.voidrush.path}>こちら</a> から利用できます。
      </p>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    if (window.location.pathname === '/creator' || window.location.pathname === '/creator/') {
      window.location.replace('/studio');
    }
  })();
</script>

<style>
  .compact {
    max-width: 720px;
  }

  .helper {
    margin-top: var(--sp-4);
  }

  .helper a {
    color: var(--brand);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
