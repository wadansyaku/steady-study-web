---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CTAButton from '@/components/CTAButton.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import InfoCard from '@/components/InfoCard.astro';
import { config, routeSeo } from '@/config';

const seo = routeSeo('automation');

const areas = [
  {
    title: '定型業務の自動化',
    icon: '⚙️',
    points: ['データ入力・集計・整形', '通知・アラートの自動化', 'SaaS / API連携によるワークフロー整備'],
  },
  {
    title: '生成AI活用の業務設計',
    icon: '🧠',
    points: ['社内ナレッジの検索・要約', '問い合わせ一次対応の効率化', 'ドキュメント作成支援と品質担保'],
  },
] as const;

const process = [
  {
    title: '課題整理',
    detail: '現状フロー・制約・セキュリティ要件を把握し、自動化対象を定義します。',
  },
  {
    title: '設計',
    detail: 'PoCで検証しながら、運用可能なアーキテクチャと運用手順を設計します。',
  },
  {
    title: '実装',
    detail: '既存業務に接続し、現場で使える粒度で導入します。',
  },
  {
    title: '改善',
    detail: '運用データを確認し、再発防止と生産性向上の改善を継続します。',
  },
] as const;
---

<BaseLayout title={seo.title} description={seo.description}>
  <section class="section hero-section">
    <div class="container narrow text-center">
      <span class="pill-badge">{config.brands.automation}</span>
      <h1 class="h1">法人向けAI自動化を、現場で回る仕組みにする。</h1>
      <p class="lead">
        机上の提案ではなく、課題整理から実装・改善まで一体で支援。
        小さく始めて、確実に効果を積み上げます。
      </p>
      <div class="actions justify-center">
        <a class="btn btn-primary" href="/contact">お問い合わせ</a>
        <CTAButton kind="line" label="LINEで相談する" variant="ghost" />
      </div>
    </div>
  </section>

  <section class="section-sm bg-surface">
    <div class="container">
      <SectionHeading title="支援領域" subtitle="Areas" center />
      <div class="grid cols-2">
        {
          areas.map((item) => (
            <InfoCard title={item.title} icon={item.icon}>
              <ul class="clean-list">
                {item.points.map((point) => <li>{point}</li>)}
              </ul>
            </InfoCard>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container">
      <SectionHeading title="進行フロー" subtitle="課題整理 → 設計 → 実装 → 改善" center />
      <div class="grid cols-4 process-grid">
        {
          process.map((item, index) => (
            <article class="card process-card">
              <p class="step">0{index + 1}</p>
              <h3 class="h3">{item.title}</h3>
              <p class="text-muted">{item.detail}</p>
            </article>
          ))
        }
      </div>
      <p class="text-center text-dim note">
        NDA・権限管理・監査要件を含む運用体制にも対応します。
      </p>
    </div>
  </section>

  <section class="section-sm">
    <div class="container narrow">
      <div class="card cta-box text-center">
        <h2 class="h2">まずは現状の業務課題をご共有ください</h2>
        <p class="text-muted">
          自動化すべき部分と、人が担うべき部分を切り分けてご提案します。
        </p>
        <div class="actions justify-center">
          <a class="btn btn-primary" href="/contact">問い合わせる</a>
          <a class="btn btn-outline" href={config.urls.consultations.automationMail}>メールで資料共有</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow {
    max-width: 920px;
  }

  .hero-section {
    padding-top: var(--sp-12);
  }

  .pill-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    background: rgba(99, 102, 241, 0.1);
    color: var(--brand);
    font-size: var(--text-sm);
    font-weight: 700;
    border: 1px solid rgba(99, 102, 241, 0.2);
    margin-bottom: var(--sp-4);
  }

  .bg-surface {
    background: rgba(30, 41, 59, 0.32);
  }

  .clean-list {
    margin: 0;
    padding-left: var(--sp-5);
    display: grid;
    gap: var(--sp-2);
  }

  .process-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .process-card {
    display: grid;
    gap: var(--sp-2);
    height: 100%;
  }

  .step {
    margin: 0;
    color: var(--text-dim);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    font-weight: 800;
  }

  .note {
    margin-top: var(--sp-5);
    font-size: var(--text-sm);
  }

  .cta-box {
    padding: var(--sp-8);
    display: grid;
    gap: var(--sp-4);
  }

  .actions {
    display: flex;
    gap: var(--sp-3);
    flex-wrap: wrap;
  }

  @media (max-width: 960px) {
    .process-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 768px) {
    .process-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
