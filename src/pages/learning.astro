---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CTAButton from '@/components/CTAButton.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import InfoCard from '@/components/InfoCard.astro';
import FAQAccordion from '@/components/FAQAccordion.astro';
import { config, routeSeo } from '@/config';

const seo = routeSeo('learning');

const pains = [
  { text: '何から手を付けるべきかが曖昧で、勉強を始める前に時間が過ぎる', icon: '🧭' },
  { text: '計画を立てても崩れやすく、修正方法が分からない', icon: '🧱' },
  { text: '模試や過去問の結果が、次の具体行動に繋がらない', icon: '📉' },
  { text: '親子で方針が噛み合わず、家庭内の負荷が高くなる', icon: '🏠' },
] as const;

const approach = [
  {
    title: '課題の診断',
    desc: '学習状況・志望校・教材を整理し、優先順位とボトルネックを明確にします。',
    icon: '🔍',
  },
  {
    title: '週次の設計',
    desc: '「今週やること」を実行可能な粒度に分解し、続けやすい運用に落とし込みます。',
    icon: '🗂️',
  },
  {
    title: '実行と改善',
    desc: '記録をもとに、週1面談でズレを修正。次週の行動まで伴走します。',
    icon: '🔁',
  },
] as const;

const faqs = [
  {
    q: '対象はどの層ですか？',
    a: '難関中学受験・難関高校受験・医学部受験（再受験含む）を中心に、現在地と目標に合わせて設計します。',
  },
  {
    q: '塾や予備校と併用できますか？',
    a: '併用を前提に設計できます。既存カリキュラムを活かしながら、家庭学習の優先順位と復習サイクルを整えます。',
  },
  {
    q: '料金の目安はありますか？',
    a: config.learning.pricingNote,
  },
];
---

<BaseLayout title={seo.title} description={seo.description}>
  <section class="section hero-section">
    <div class="container hero-grid">
      <div>
        <span class="pill-badge">{config.brands.learning}</span>
        <h1 class="h1">
          親と子の不安を、
          <span class="text-brand">実行できる計画</span>に変える。
        </h1>
        <p class="lead">
          面談予約を起点に、現状整理から伴走までを一貫対応。
          気合ではなく、再現できる学習運用を作ります。
        </p>
        <div class="actions">
          <CTAButton kind="line" label="LINEで無料面談を予約" />
          <CTAButton kind="booking" label="Webで面談日程を確認" variant="outline" />
        </div>
        <p class="text-dim note">{config.learning.bookingNote}</p>
      </div>

      <InfoCard title="初回面談で整理すること" class="trust-card">
        <ul class="clean-list">
          <li>志望校・現状・残り期間の整理</li>
          <li>止まっている原因の特定</li>
          <li>次の2週間で実行する優先順位</li>
        </ul>
      </InfoCard>
    </div>
  </section>

  <section class="section-sm">
    <div class="container">
      <SectionHeading title="よくある詰まり" subtitle="Current Issues" center />
      <div class="grid cols-2">
        {
          pains.map((item) => (
            <InfoCard title="" icon={item.icon} class="pain-card">
              <p>{item.text}</p>
            </InfoCard>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-sm bg-surface">
    <div class="container">
      <SectionHeading title="伴走の進め方" subtitle="Method" center />
      <div class="grid cols-3">
        {
          approach.map((item) => (
            <InfoCard title={item.title} icon={item.icon}>
              <p>{item.desc}</p>
            </InfoCard>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container narrow">
      <SectionHeading title="プラン" subtitle="Plans" center />
      <p class="text-center text-muted pricing-note">{config.learning.pricingNote}</p>
      <div class="grid cols-2">
        {
          config.learning.plans.map((plan) => (
            <article class="card plan-card">
              <div class="plan-head">
                <h3 class="h3">{plan.name}</h3>
                <p class="price">{plan.price}</p>
              </div>
              <ul class="plan-list">
                {plan.features.map((feature) => <li>{feature}</li>)}
              </ul>
              <CTAButton kind="line" label="このプランを相談する" class="w-full" />
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container narrow">
      <SectionHeading title="よくある質問" subtitle="FAQ" center />
      <FAQAccordion items={faqs} />
    </div>
  </section>

  <section class="section-sm">
    <div class="container narrow">
      <div class="card final-cta text-center">
        <h2 class="h2">面談予約から始めましょう</h2>
        <p class="text-muted">
          現状整理だけでも歓迎です。親子の負担を減らしながら、次の行動が明確になる状態を作ります。
        </p>
        <div class="actions justify-center">
          <CTAButton kind="line" label="LINEで無料面談を予約" />
          <CTAButton kind="booking" label="Webで予約する" variant="outline" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-section {
    padding-top: var(--sp-12);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: var(--sp-8);
    align-items: start;
  }

  .pill-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    background: rgba(99, 102, 241, 0.1);
    color: var(--brand);
    font-size: var(--text-sm);
    font-weight: 700;
    border: 1px solid rgba(99, 102, 241, 0.2);
    margin-bottom: var(--sp-4);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }

  .note {
    margin-top: var(--sp-4);
    font-size: var(--text-sm);
  }

  .clean-list {
    margin: 0;
    padding-left: var(--sp-5);
    display: grid;
    gap: var(--sp-2);
  }

  .pain-card p {
    margin: 0;
    font-weight: 600;
    line-height: 1.6;
  }

  .bg-surface {
    background: rgba(30, 41, 59, 0.32);
  }

  .narrow {
    max-width: 900px;
  }

  .pricing-note {
    margin-top: calc(-1 * var(--sp-4));
    margin-bottom: var(--sp-8);
    font-size: var(--text-sm);
  }

  .plan-card {
    display: grid;
    gap: var(--sp-4);
    height: 100%;
  }

  .plan-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--sp-3);
    border-bottom: 1px solid var(--border);
    padding-bottom: var(--sp-3);
  }

  .price {
    margin: 0;
    color: var(--brand);
    font-weight: 700;
  }

  .plan-list {
    margin: 0;
    padding-left: var(--sp-5);
    color: var(--text-muted);
    display: grid;
    gap: var(--sp-2);
  }

  .final-cta {
    padding: var(--sp-8);
    display: grid;
    gap: var(--sp-4);
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
